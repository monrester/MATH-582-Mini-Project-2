import contextlib
import io

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from IPython.display import display
from sklearn.decomposition import PCA
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.impute import SimpleImputer


def visualize_dataset(data, label=None, name="dataset", max_n=1500, seed=42):
    """
    Run all four kernels on a dataset (same inputs as run_dataset) and draw, for EACH kernel:
      row 1: decision boundary (2-D PCA view of the features)
      row 2: confusion matrix on the test set
      row 3: histogram of decision values f(x) on the test set (margins at -1, 0, +1)
    plus a bar chart comparing the kernels. Hyperparameters are the cross-validated ones from run_dataset.
    """
    # ---- run the cross-validated search quietly; keep only the results table
    with contextlib.redirect_stdout(io.StringIO()):
        res, _ = run_dataset(data, label=label, max_n=max_n, seed=seed)

    # ---- reproduce run_dataset's split and preprocessing (same seed) so we can refit each kernel
    X_df, y_raw = _prepare(data, label)
    classes, counts = np.unique(y_raw, return_counts=True)
    pos, neg = classes[np.argmin(counts)], classes[np.argmax(counts)]
    y = np.where(y_raw == pos, 1.0, -1.0)
    n_total, n_pos = len(y), int((y == 1).sum())
    if len(y) > max_n:
        rng = np.random.default_rng(seed)
        ip, ineg = np.where(y == 1)[0], np.where(y == -1)[0]
        ip = rng.choice(ip, min(len(ip), max_n // 2), replace=False)
        ineg = rng.choice(ineg, max_n - len(ip), replace=False)
        keep = np.sort(np.r_[ip, ineg])
        X_df, y = X_df.iloc[keep].reset_index(drop=True), y[keep]
    Xtr, Xte, ytr, yte = train_test_split(X_df.values, y, test_size=0.25, random_state=seed, stratify=y)
    imp = SimpleImputer(strategy="median").fit(Xtr)
    Xtr, Xte = imp.transform(Xtr), imp.transform(Xte)
    sc, d = StandardScaler().fit(Xtr), Xtr.shape[1]
    Xtr, Xte = sc.transform(Xtr) / np.sqrt(d), sc.transform(Xte) / np.sqrt(d)
    cw = "balanced" if (ytr == 1).mean() < 0.30 else None
    names = [str(neg), str(pos)]                                   # display names for [-1, +1]

    print(f"{name}: {n_total} rows, {d} features.  +1 = '{pos}' ({n_pos / n_total:.1%}), -1 = '{neg}'.  "
          f"Train {len(ytr)}, test {len(yte)}, class_weight={cw}\n")

    # ---- clean results table
    table = res[["kernel", "cv_bal_acc", "test_acc", "precision", "recall", "f1", "n_SV"]].copy()
    table["params"] = res["params"].apply(lambda p: ", ".join(f"{k}={float(v):g}" for k, v in p.items()))
    display(table.round(3))

    # ---- 2-D PCA view for the boundary row
    pca = PCA(2).fit(Xtr)
    Ztr, Zte = pca.transform(Xtr), pca.transform(Xte)
    s = Ztr.std(0); Ztr, Zte = Ztr / s, Zte / s

    fig, axes = plt.subplots(3, 4, figsize=(17, 12))
    warned = False
    for j, (k, p) in enumerate(KERNELS):
        params = res.loc[res.kernel == k, "params"].iloc[0]
        m = DualSVM(k, class_weight=cw, **params).fit(Xtr, ytr)             # full-dimensional best model
        if abs(m.score(Xte, yte) - res.loc[res.kernel == k, "test_acc"].iloc[0]) > 1e-9 and not warned:
            print("note: could not exactly reproduce one of the test scores; plots may differ slightly")
            warned = True

        # row 1: boundary in 2-D PCA space (illustration: a separate 2-D model with the same C)
        m2 = DualSVM(k, C=params["C"], class_weight=cw, **p).fit(Ztr, ytr)
        ax = axes[0, j]
        plot_boundary(m2, Ztr, ytr, ax, f"{k}  (2-D PCA view)")
        ax.scatter(Zte[yte == 1, 0], Zte[yte == 1, 1], marker="x", c="navy", s=28)
        ax.scatter(Zte[yte == -1, 0], Zte[yte == -1, 1], marker="x", c="darkred", s=28)

        # row 2: confusion matrix of the full model
        pred = m.predict(Xte)
        cm = np.array([[np.sum((yte == a) & (pred == b)) for b in (-1, 1)] for a in (-1, 1)])
        ax = axes[1, j]
        ax.imshow(cm, cmap="Blues")
        for a in range(2):
            for b in range(2):
                ax.text(b, a, cm[a, b], ha="center", va="center", fontsize=18,
                        color="white" if cm[a, b] > cm.max() / 2 else "black")
        ax.set_xticks([0, 1]); ax.set_xticklabels(names); ax.set_yticks([0, 1]); ax.set_yticklabels(names)
        ax.set_xlabel("predicted"); ax.set_ylabel("true")
        ax.set_title(f"{k}: test acc {m.score(Xte, yte):.3f}")

        # row 3: decision values on the test set
        f = m.decision_function(Xte)
        ax = axes[2, j]
        bins = np.linspace(f.min(), f.max(), 30)
        ax.hist(f[yte == -1], bins, alpha=.6, color="red", label=names[0])
        ax.hist(f[yte == 1], bins, alpha=.6, color="blue", label=names[1])
        for v, ls in ((-1, "--"), (0, "-"), (1, "--")):
            ax.axvline(v, color="k", ls=ls, lw=1)
        ax.set_xlabel("decision value f(x)"); ax.set_title(f"{k}: margins"); ax.legend(fontsize=8)
    axes[0, 0].set_ylabel("2-D PCA view"); axes[2, 0].set_ylabel("test points")
    plt.suptitle(f"{name}: all four kernels (row 1 is an illustration in 2-D; rows 2-3 use the full model)", fontsize=12)
    plt.tight_layout()
    tag = name.replace(" ", "_")
    plt.savefig(f"{tag}_kernels.png", dpi=130); plt.show()

    # ---- bar chart of test metrics per kernel
    fig, ax = plt.subplots(figsize=(8, 4))
    res.set_index("kernel")[["test_acc", "precision", "recall", "f1"]].reindex([k for k, _ in KERNELS]).plot.bar(ax=ax, rot=0)
    ax.set_ylim(0, 1.08); ax.set_xlabel(""); ax.set_title(f"{name}: test metrics by kernel (+1 = '{pos}')")
    ax.legend(loc="lower right", ncol=4, fontsize=8)
    plt.tight_layout(); plt.savefig(f"{tag}_metrics.png", dpi=130); plt.show()
    return res
